# Slipway backend configuration.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
# In production the app refuses to start without SLIPWAY_ATTESTOR_SECRET.
NODE_ENV=development

# Port the API listens on.
PORT=8787

# SQLite file. Use :memory: for an ephemeral database.
SLIPWAY_DB_PATH=./slipway.db

# Comma-separated browser origins allowed by CORS, or * for any.
SLIPWAY_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Attestation (optional in development, required in production)
# ---------------------------------------------------------------------------

# The service account's Stellar secret seed, used ONLY to sign attestation
# writes. It is never logged, never returned by any endpoint, and never leaves
# this process. Generate one with:
#
#   stellar keys generate --global slipway --network testnet --fund
#   stellar keys show slipway
#
# Leave unset in development and attestation is simply turned off.
SLIPWAY_ATTESTOR_SECRET=

# Contract id of the deployed attestations contract, from `stellar contract
# deploy` in Phase 3. Attestation stays off until both this and the secret are
# set.
SLIPWAY_ATTESTATIONS_CONTRACT=

# Soroban RPC endpoint and the matching network passphrase.
SLIPWAY_SOROBAN_RPC=https://soroban-testnet.stellar.org
SLIPWAY_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---------------------------------------------------------------------------
# Poller
# ---------------------------------------------------------------------------

# Set to false to run the API without the scheduled poller.
SLIPWAY_POLL_ENABLED=true

# Cron expression. Default is every fifteen minutes.
SLIPWAY_POLL_CRON=*/15 * * * *

# Notional the poller quotes on every corridor, in the sell asset.
SLIPWAY_POLL_NOTIONAL=100

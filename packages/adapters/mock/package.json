{
  "name": "@slipwaykit/adapter-mock",
  "version": "0.1.0",
  "description": "A deterministic in-memory Slipway adapter for demos, tests and conformance runs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
